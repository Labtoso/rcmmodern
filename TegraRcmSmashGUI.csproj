<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ist auf jedem Windows 10/11 vorinstalliert: kleine EXE, laeuft ueberall ohne Runtime -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RcmGui</AssemblyName>
    <RootNamespace>RcmGui</RootNamespace>
    <ApplicationIcon>data\app.ico</ApplicationIcon>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>RcmGui</Product>
    <Company>LabtosoStudios</Company>
    <Copyright>© LabtosoStudios</Copyright>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon fuer Fenster und Taskleiste zur Laufzeit -->
    <EmbeddedResource Include="data\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- ValueTuple ist in net48 enthalten -->
  </ItemGroup>

</Project>
